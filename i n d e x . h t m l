<option value="+351">🇵🇹 +351 Portugal</option>
<option value="+86">🇨🇳 +86 Chine</option>
<option value="+81">🇯🇵 +81 Japon</option>
<option value="+82">🇰🇷 +82 Corée</option>
<option value="+91">🇮🇳 +91 Inde</option>
<option value="+971">🇦🇪 +971 Dubaï</option>
<option value="+966">🇸🇦 +966 Arabie Saoudite</option>
<option value="+90">🇹🇷 +90 Turquie</option>
<option value="+55">🇧🇷 +55 Brésil</option>
<option value="+52">🇲🇽 +52 Mexique</option> 
      </select>
      <input class="login-field" id="loginPhone" type="tel" placeholder="Numéro de téléphone" style="margin-bottom:0; flex:1" autocomplete="off">
    </div>

    <button class="btn-login" onclick="seConnecter()">Se connecter</button>
    <div class="login-error" id="loginError">Veuillez remplir tous les champs correctement.</div>
  </div>

  <!-- LISTE -->
  <div id="listScreen">
    <header>
      <div style="display:flex;align-items:center">
        <span class="menu-btn" onclick="togglePremium()">⋮</span>
        <h2>Talksy</h2>
      </div>
      <div class="header-actions">
        <span onclick="ouvrirNouveauStatut()" title="Nouveau statut">📸</span>
        <div class="user-badge" onclick="deconnecter()" title="Cliquer pour déconnexion">
          <span class="avatar-circle" id="headerAvatar">?</span>
        </div>
      </div>
    </header>
    
    <!-- Menu Premium -->
    <div id="premiumMenu">
      <h3>👑 Premium</h3>
      <p>Débloquez les conversations de groupe et les appels vidéo à plusieurs.</p>
      <button onclick="payerPremium()">S'abonner (5$/mois)</button>
    </div>

    <div id="statusBar" style="display:none"></div>
    <div class="search"><input type="text" placeholder="🔍 Rechercher..." onkeyup="filtrer(this.value)"></div>
    <div id="liste"></div>
    
    <!-- Bouton Ajout Contact -->
    <div class="fab-add" onclick="ajouterContact()">+</div>
  </div>

  <!-- CHAT -->
  <div id="chatScreen">
    <div class="chat-header">
      <button onclick="retour()">←</button>
      <div class="avatar" id="chatAvatar">I</div>
      <div class="chat-header-info">
        <b id="chatNom">Nom</b>
        <small id="chatStatus">en ligne</small>
      </div>
    </div>
    <div id="messages"></div>
    <div class="input-bar">
      <label class="icon-btn" for="fileInput" title="Envoyer un fichier" style="cursor:pointer;display:flex">📎</label>
      <input type="file" id="fileInput" style="display:none" onchange="envoyerFichier(this)">
      <input id="inputMsg" placeholder="Écrire un message..." onkeydown="if(event.key==='Enter') envoyer()">
      <button onclick="envoyer()">➤</button>
