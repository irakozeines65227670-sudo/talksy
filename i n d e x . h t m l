</div>

<!-- Status viewer -->
<div id="statusViewer">
  <div class="sv-header"><b id="svNom">Statut</b></div>
  <button class="sv-close" onclick="fermerStatus()">✕</button>
  <div class="sv-body" id="svBody"></div>
</div>

<!-- New status modal -->
<div id="newStatusModal">
  <div class="box">
    <h3>📸 Nouveau statut</h3>
    <input type="file" id="statusFile" accept="image/*,video/*">
    <input type="text" id="statusCaption" placeholder="Légende (optionnel)" style="background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:white;padding:12px;border-radius:8px;width:100%;margin-top:10px;outline:none">
    <div class="row">
      <button class="cancel" onclick="fermerNouveauStatut()">Annuler</button>
      <button class="ok" onclick="publierStatut()">Publier</button>
    </div>
  </div>
</div>

<script>
/* ============ CONFIG CORRIGÉE POUR LE WEB ============ */
const API = window.location.origin; 
const socket = io();

/* ============ STATE ============ */
let utilisateur = null;
let contacts = {};
let chatActuelId = null;
let messagesParChat = {};
let statuts = [];
let avatarData = null;

/* ============ SPLASH → LOGIN ============ */
setTimeout(()=>{
  document.getElementById("splash").style.display = "none";
  const saved = localStorage.getItem("talksy_user");
  if (saved) {
    utilisateur = JSON.parse(saved);
    entrerApp();
  } else {
    document.getElementById("loginScreen").style.display = "flex";
  }
}, 2600);

/* ============ LOGIN ============ */
function previewAvatar(input){
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    avatarData = e.target.result;
    const el = document.getElementById("avatarUpload");
    el.style.backgroundImage = `url(${avatarData})`;
    document.getElementById("avatarUploadText").style.display = "none";
  };
  reader.readAsDataURL(file);
}

async function seConnecter(){
  const nom = document.getElementById("loginName").value.trim();
  const code = document.getElementById("countryCode").value;
  const num = document.getElementById("loginPhone").value.trim();
  const telComplet = code + num;
  const err = document.getElementById("loginError");
  
  if(nom.length < 2 || num.length < 5){
    err.style.display = "block"; return;
  }
  err.style.display = "none";
  try{
    const res = await fetch(API + "/api/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ nom, telephone: telComplet, avatar: avatarData })
    });
    utilisateur = await res.json();
    localStorage.setItem("talksy_user", JSON.stringify(utilisateur));
    entrerApp();
  }catch(e){
    alert("Impossible de joindre le serveur.");
  }
}

function deconnecter(){
  if(confirm("Se déconnecter ?")){
    localStorage.removeItem("talksy_user");
    location.reload();
  }
}

function entrerApp(){
  document.getElementById("loginScreen").style.display = "none";
  document.getElementById("listScreen").style.display = "flex";
  document.getElementById("headerAvatar").innerHTML = utilisateur.avatar
    ? `<img src="${utilisateur.avatar}" style="width:100%;height:100%;border-radius:50%;object-fit:cover">`
    : utilisateur.nom[0].toUpperCase();

  socket.emit("user:online", utilisateur.id);
  chargerUtilisateurs();
  chargerStatuts();
}

/* ============ PREMIUM ============ */
function togglePremium(){
  const m = document.getElementById("premiumMenu");
  m.style.display = m.style.display === "block" ? "none" : "block";
}
function payerPremium(){
  alert("Paiement Mobile Money / Carte à venir. Fonctionnalité Premium bientôt disponible !");
  togglePremium();
}

/* ============ AJOUTER CONTACT ============ */
function ajouterContact(){
  const num = prompt("Entrez le numéro de téléphone de votre contact (avec le code pays ex: +243...) :");
  if(!num) return;
  fetch(API + "/api/users").then(r => r.json()).then(users => {
    const found = users.find(u => u.telephone.includes(num));
    if(found){
      alert("Contact trouvé : " + found.nom);
      contacts[found.id] = found;
      afficherListe();
    } else {
      alert("Aucun utilisateur Talksy trouvé avec ce numéro.");
    }
  });
}

/* ============ SOCKET LISTENERS ============ */
socket.on("users:update", (users) => {
  contacts = {};
  users.forEach(u => { if (u.id !== utilisateur.id) contacts[u.id] = u; });
  afficherListe();
});

socket.on("message:new", (m) => {
  const key = chatKey(m.from, m.to);
  if (!messagesParChat[key]) messagesParChat[key] = [];
  messagesParChat[key].push(m);
  if (chatActuelId && (m.from === chatActuelId || m.to === chatActuelId) && m.from !== utilisateur.id) {
    afficherMessages();
  }
  afficherListe();
});

socket.on("status:new", (s) => {
  statuts.push(s);
  afficherStatuts();
});

/* ============ CHARGEMENT ============ */
async function chargerUtilisateurs(){
  try {
    const res = await fetch(API + "/api/users");
    const users = await res.json();
    contacts = {};
    users.forEach(u => { if (u.id !== utilisateur.id) contacts[u.id] = u; });
    afficherListe();
  } catch(e){}
}

async function chargerStatuts(){
  try {
    const res = await fetch(API + "/api/statuses");
    statuts = await res.json();
    afficherStatuts();
  } catch(e){}
}

/* ============ LISTE CONTACTS ============ */
function couleurAvatar(nom){
  const c = ["#1a3a5c","#2d1b3d","#1e3a5f","#3d1b2d","#1b3d3a","#0a1929"];
  let h=0; for(let i=0;i<nom.length;i++) h = nom.charCodeAt(i)+((h<<5)-h);
  return c[Math.abs(h)%c.length];
}

function afficherListe(filtre=""){
  const liste = Object.values(contacts);
  if (!liste.length){
    document.getElementById("liste").innerHTML = '<div style="padding:30px;text-align:center;color:#88a0bb">Aucun contact. Clique sur le bouton + en bas à gauche.</div>';
    return;
  }
  let html = "";
  liste.forEach(u => {
    if (!u.nom.toLowerCase().includes(filtre.toLowerCase())) return;
    const av = u.avatar
      ? `<div class="avatar" style="background-image:url(${u.avatar})"></div>`
      : `<div class="avatar" style="background:${couleurAvatar(u.nom)}">${u.nom[0].toUpperCase()}</div>`;
    html += `<div class="contact" onclick="ouvrirChat('${u.id}')">
      ${av}
      <div class="info"><b>${u.nom}</b><span>${u.telephone}</span></div>
    </div>`;
  });
  document.getElementById("liste").innerHTML = html || '<div style="padding:30px;text-align:center;color:#88a0bb">Aucun résultat</div>';
}
function filtrer(v){ afficherListe(v); }

/* ============ OUVRIR CHAT ============ */
function ouvrirChat(id){
  chatActuelId = id;
  const u = contacts[id];
  document.getElementById("listScreen").style.display = "none";
  document.getElementById("chatScreen").style.display = "flex";
  document.getElementById("chatNom").innerText = u.nom;
  document.getElementById("chatStatus").innerText = u.online ? "en ligne" : "vu récemment";
  const av = document.getElementById("chatAvatar");
  if (u.avatar){
    av.style.backgroundImage = `url(${u.avatar})`;
    av.style.backgroundSize = "cover";
    av.innerText = "";
  } else {
    av.style.backgroundImage = "";
    av.style.background = couleurAvatar(u.nom);
    av.innerText = u.nom[0].toUpperCase();
  }
  afficherMessages();
}

function chatKey(a,b){ return [a,b].sort().join("_"); }

function afficherMessages(){
  if (!chatActuelId) return;
  const key = chatKey(utilisateur.id, chatActuelId);
  const list = messagesParChat[key] || [];
  let html = "";
  list.forEach(m => {
    const classe = m.from === utilisateur.id ? "moi" : "lui";
    let contenu = "";
    if (m.text) contenu += escapeHtml(m.text);
    if (m.media) {
      if (m.media.type?.startsWith("image")) {
        contenu += `<img class="media" src="${API}${m.media.url}" onclick="window.open('${API}${m.media.url}')">`;
      } else if (m.media.type?.startsWith("video")) {
        contenu += `<video controls src="${API}${m.media.url}" style="max-width:100%;border-radius:10px;margin-top:6px"></video>`;
      } else {
        contenu += `<a href="${API}${m.media.url}" download="${m.media.name}" target="_blank" style="color:inherit">📄 ${escapeHtml(m.media.name)}</a>`;
      }
    }
    const check = m.from === utilisateur.id ? '<span style="color:#4fc3f7;margin-left:3px">✓✓</span>' : "";
    html += `<div class="msg ${classe}">${contenu}<span class="msg-time">${m.heure}${check}</span></div>`;
  });
  const div = document.getElementById("messages");
  div.innerHTML = html;
  div.scrollTop = div.scrollHeight;
}

/* ============ ENVOI ============ */
function heureActuelle(){
  const d = new Date();
  return d.getHours().toString().padStart(2,"0") + ":" + d.getMinutes().toString().padStart(2,"0");
}

function envoyer(){
  const input = document.getElementById("inputMsg");
  const texte = input.value.trim();
  if (!texte || !chatActuelId) return;
  const msg = {
    id: Date.now() + "_" + Math.random(),
    from: utilisateur.id,
    to: chatActuelId,
    text: texte,
    heure: heureActuelle(),
    lu: false
  };
  socket.emit("message:send", msg);
  input.value = "";
}

async function envoyerFichier(input){
  const file = input.files[0];
  if (!file || !chatActuelId) return;
  const fd = new FormData();
  fd.append("file", file);
  try{
    const res = await fetch(API + "/upload", { method: "POST", body: fd });
    const data = await res.json();
    const msg = {
      id: Date.now() + "_" + Math.random(),
      from: utilisateur.id,
      to: chatActuelId,
      text: "",
      media: data,
      heure: heureActuelle(),
      lu: false
    };
    socket.emit("message:send", msg);
  } catch(e){ alert("Échec envoi fichier"); }
  input.value = "";
}

function escapeHtml(s){
  return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function retour(){
  document.getElementById("chatScreen").style.display = "none";
  document.getElementById("listScreen").style.display = "flex";
  chatActuelId = null;
  afficherListe();
}

/* ============ STATUTS ============ */
function afficherStatuts(){
  const bar = document.getElementById("statusBar");
  bar.style.display = "flex";
  let html = `<div class="status-item" onclick="ouvrirNouveauStatut()" style="display:flex;flex-direction:column;align-items:center;margin-right:15px;cursor:pointer">
    <div class="ring self" style="width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#667781,#667781);padding:2px;position:relative">
      <div class="avatar-circle" style="width:100%;height:100%;border-radius:50%;border:2px solid #0a1929;background:var(--primary-light);display:flex;align-items:center;justify-content:center;overflow:hidden">${utilisateur.avatar ? `<img src="${utilisateur.avatar}" style="width:100%;height:100%;object-fit:cover">` : utilisateur.nom[0].toUpperCase()}</div>
    </div>
    <small style="color:#ccc;font-size:11px;margin-top:4px">Mon statut</small>
  </div>`;
  statuts.forEach(s => {
    html += `<div class="status-item" onclick="voirStatut('${s.id}')" style="display:flex;flex-direction:column;align-items:center;margin-right:15px;cursor:pointer">
      <div class="ring" style="width:60px;height:60px;border-radius:50%;padding:2px;background:linear-gradient(135deg,#ff4081,#5b9bd5)">
        <div class="avatar-circle" style="width:100%;height:100%;border-radius:50%;border:2px solid #0a1929;background:var(--primary-light);display:flex;align-items:center;justify-content:center;overflow:hidden">${s.userAvatar ? `<img src="${s.userAvatar}" style="width:100%;height:100%;object-fit:cover">` : s.userName[0].toUpperCase()}</div>
      </div>
      <small style="color:#ccc;font-size:11px;margin-top:4px">${escapeHtml(s.userName)}</small>
    </div>`;
  });
  bar.innerHTML = html;
}

function ouvrirNouveauStatut(){ document.getElementById("newStatusModal").style.display = "flex"; }
function fermerNouveauStatut(){ document.getElementById("newStatusModal").style.display = "none"; }
async function publierStatut(){
  const file = document.getElementById("statusFile").files[0];
  const cap = document.getElementById("statusCaption").value;
  if (!file) return alert("Choisis un fichier");
  const fd = new FormData(); fd.append("file", file);
  const res = await fetch(API + "/upload", { method: "POST", body: fd });
  const data = await res.json();
  const status = { id: Date.now()+"_"+Math.random(), userId: utilisateur.id, userName: utilisateur.nom, userAvatar: utilisateur.avatar, media: data, caption: cap, time: Date.now() };
  socket.emit("status:new", status);
  fermerNouveauStatut();
}

function voirStatut(id){
  const s = statuts.find(x => x.id === id);
  if (!s) return;
  document.getElementById("svNom").innerText = s.userName;
  const body = document.getElementById("svBody");
  if (s.media.type?.startsWith("image")) body.innerHTML = `<img src="${API}${s.media.url}">`;
  else if (s.media.type?.startsWith("video")) body.innerHTML = `<video autoplay controls src="${API}${s.media.url}"></video>`;
  document.getElementById("statusViewer").style.display = "flex";
}
function fermerStatus(){
  document.getElementById("statusViewer").style.display = "none";
  document.getElementById("svBody").innerHTML = "";
}
