<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Talksy</title>
<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',Arial,sans-serif}
:root{
  --primary:#0a1929;
  --primary-light:#1a3a5c;
  --accent:#25D366;
  --pink-neon:#ff4081;
  --glass:rgba(10,25,41,0.55);
  --glass-border:rgba(255,64,129,0.3);
}
body{background:#000;display:flex;justify-content:center;align-items:center;height:100vh;overflow:hidden}
.app{width:100%;max-width:450px;height:100vh;background:#f0f2f5;display:flex;flex-direction:column;overflow:hidden;position:relative}

/* ===== SPLASH ===== */
#splash{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;justify-content:center;align-items:center;background:linear-gradient(160deg,#0a1929 0%,#1a3a5c 50%,#2d1b3d 100%);color:white;animation:splashOut 2.6s ease forwards;}
#splash h1{font-size:56px;letter-spacing:2px;font-weight:800}
#splash h1 span{color:var(--accent)}
#splash p{margin-top:10px;opacity:.6;font-size:14px;letter-spacing:3px;text-transform:uppercase}
#splash .dot{width:10px;height:10px;border-radius:50%;background:var(--accent);margin-top:40px;animation:pulse 1s infinite}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.6);opacity:.4}}
@keyframes splashOut{0%,80%{opacity:1;visibility:visible}100%{opacity:0;visibility:hidden}}

/* ===== LOGIN ===== */
#loginScreen{display:none;flex-direction:column;justify-content:center;align-items:center;height:100%;padding:40px 30px;background:linear-gradient(160deg,#0a1929 0%,#1a3a5c 50%,#2d1b3d 100%);color:white;}
#loginScreen h1{font-size:38px;margin-bottom:8px;letter-spacing:1px}
#loginScreen h1 span{color:var(--accent)}
#loginScreen p{opacity:.7;margin-bottom:35px;font-size:14px;text-align:center}
.login-field{width:100%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:14px 16px;color:white;font-size:15px;margin-bottom:14px;outline:none;backdrop-filter:blur(10px);}
.login-field::placeholder{color:rgba(255,255,255,.5)}
.login-field:focus{border-color:var(--accent);background:rgba(255,255,255,.15)}
.avatar-upload{width:100px;height:100px;border-radius:50%;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:36px;cursor:pointer;margin-bottom:20px;border:2px dashed rgba(255,255,255,.3);background-size:cover;background-position:center;overflow:hidden;transition:.2s;position:relative;}
.avatar-upload:hover{border-color:var(--accent)}
.avatar-upload .plus-badge{position:absolute;bottom:0;right:0;background:var(--accent);color:#0a1929;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:20px;border:2px solid #0a1929}
.btn-login{width:100%;padding:15px;border:none;border-radius:12px;font-size:16px;font-weight:600;background:var(--accent);color:#0a1929;cursor:pointer;margin-top:10px;transition:.3s;}
.btn-login:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(37,211,102,.4)}
.login-error{color:#ff6b6b;font-size:13px;margin-top:10px;display:none}

/* ===== LISTE ===== */
#listScreen{display:none;flex-direction:column;height:100%;background:linear-gradient(160deg,#0a0a0a 0%,#1a0b14 50%,#0a1929 100%)}
header{background:rgba(15,10,15,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--glass-border);color:white;padding:14px 18px;display:flex;justify-content:space-between;align-items:center;position:relative;z-index:10;}
header h2{font-size:19px;display:flex;align-items:center;gap:8px;color:#ffd6e6}
header h2 .logo-dot{width:10px;height:10px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}
.header-actions{display:flex;gap:14px;align-items:center}
.header-actions span{cursor:pointer;font-size:18px;opacity:.85;transition:.2s}
.header-actions span:hover{opacity:1;transform:scale(1.15)}
.user-badge{background:rgba(255,255,255,.12);padding:4px 10px 4px 4px;border-radius:20px;font-size:12px;display:flex;align-items:center;gap:6px;cursor:pointer;}
.user-badge img,.user-badge .avatar-circle{width:24px;height:24px;border-radius:50%;object-fit:cover;background:var(--pink-neon);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#0a1929}

.menu-btn{cursor:pointer;font-size:24px;margin-right:10px;color:var(--pink-neon)}
#premiumMenu{display:none;position:absolute;top:60px;left:10px;background:rgba(20,20,20,.95);border:1px solid var(--pink-neon);border-radius:12px;padding:15px;z-index:100;color:white;box-shadow:0 10px 30px rgba(255,64,129,.3);width:220px;}
#premiumMenu h3{color:var(--pink-neon);margin-bottom:10px;font-size:16px}
#premiumMenu p{font-size:12px;opacity:.8;margin-bottom:15px;line-height:1.4}
#premiumMenu button{width:100%;padding:10px;background:var(--pink-neon);border:none;border-radius:8px;font-weight:bold;color:#0a1929;cursor:pointer}

.search{background:rgba(15,10,15,.7);padding:10px 12px}
.search input{width:100%;padding:11px 16px;border:none;border-radius:10px;outline:none;background:rgba(255,255,255,.12);color:white;font-size:14px;backdrop-filter:blur(10px);}
.search input::placeholder{color:rgba(255,255,255,.5)}

#liste{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:10px;}
.contact{display:flex;gap:12px;padding:12px 14px;border-radius:16px;cursor:pointer;transition:.2s;align-items:center;background:rgba(255,255,255,.05);backdrop-filter:blur(14px);border:1px solid rgba(255,64,129,.15);box-shadow:0 4px 20px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.06);}
.contact:hover{background:rgba(255,64,129,.12);transform:translateY(-2px);border-color:rgba(255,64,129,.35);box-shadow:0 8px 26px rgba(255,64,129,.35);}
.contact:active{transform:scale(.98)}
.avatar{width:52px;height:52px;border-radius:50%;color:white;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:bold;flex-shrink:0;position:relative;background-size:cover;background-position:center;box-shadow:0 4px 14px rgba(0,0,0,.4);}
.info{flex:1;min-width:0}
.info b{display:block;font-size:15px;margin-bottom:3px;color:#ffd6e6}
.info span{color:rgba(255,220,235,.7);font-size:13px;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Bouton flottant ajouter contact */
.fab-add{position:absolute;bottom:20px;left:20px;background:var(--pink-neon);color:#0a1929;width:55px;height:55px;border-radius:50%;font-size:26px;display:flex;align-items:center;justify-content:center;font-weight:bold;box-shadow:0 5px 15px rgba(255,64,129,.5);cursor:pointer;z-index:50;transition:.2s;border:none;}
.fab-add:hover{transform:scale(1.1)}

/* ===== CHAT ===== */
#chatScreen{display:none;flex-direction:column;height:100%;background:#0a0f18}
.chat-header{background:rgba(15,10,15,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--glass-border);color:white;padding:10px 14px;display:flex;align-items:center;gap:10px;}
.chat-header button{background:none;border:none;color:white;font-size:22px;cursor:pointer;padding:4px 8px;border-radius:50%;transition:.2s;}
.chat-header button:hover{background:rgba(255,255,255,.15)}
.chat-header .avatar{width:42px;height:42px;font-size:17px}
.chat-header-info{flex:1}
.chat-header-info b{display:block;font-size:16px;color:#ffd6e6}
.chat-header-info small{font-size:11px;opacity:.75}

#messages{flex:1;padding:16px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;background:linear-gradient(160deg,#0a0a0a 0%,#1a0b14 50%,#0a1929 100%);}
.msg{max-width:78%;padding:10px 14px;border-radius:16px;font-size:15px;line-height:1.4;position:relative;word-wrap:break-word;animation:popIn .25s ease;}
@keyframes popIn{from{opacity:0;transform:translateY(8px) scale(.96)}to{opacity:1;transform:translateY(0) scale(1)}}
.lui{align-self:flex-start;background:linear-gradient(135deg,#5b9bd5 0%,#ff9ec7 100%);color:#fff;border-bottom-left-radius:4px;box-shadow:0 4px 18px rgba(255,158,199,.5);}
.moi{align-self:flex-end;background:linear-gradient(135deg,#0a1929 0%,#1e3a5f 100%);color:#e8f0f8;border-bottom-right-radius:4px;box-shadow:0 3px 12px rgba(10,25,41,.35);border:1px solid rgba(255,64,129,.15);}
.msg img.media{max-width:100%;border-radius:10px;margin-top:6px;display:block;cursor:pointer}
.msg .msg-time{display:block;font-size:10px;opacity:.65;text-align:right;margin-top:4px}

.input-bar{display:flex;padding:10px;gap:8px;background:rgba(15,10,15,.9);border-top:1px solid var(--glass-border);align-items:center;}
.input-bar input{flex:1;padding:13px 18px;border:none;border-radius:24px;outline:none;font-size:15px;background:rgba(255,255,255,.1);color:white;}
.input-bar input::placeholder{color:rgba(255,255,255,.5)}
.input-bar button{background:var(--pink-neon);border:none;color:#0a1929;width:46px;height:46px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s;font-weight:700;}
.input-bar button:hover{transform:scale(1.08);box-shadow:0 4px 14px rgba(255,64,129,.5)}
.input-bar .icon-btn{background:none;color:#ffd6e6;font-size:22px;width:auto;height:auto;padding:0 4px}
.input-bar .icon-btn:hover{color:var(--pink-neon);transform:scale(1.15);box-shadow:none}

/* Modal status */
#statusViewer{display:none;position:fixed;inset:0;z-index:9998;background:#000;flex-direction:column;}
#statusViewer .sv-header{padding:14px;color:white;display:flex;align-items:center;gap:10px}
#statusViewer .sv-body{flex:1;display:flex;align-items:center;justify-content:center;padding:20px}
#statusViewer .sv-body img,#statusViewer .sv-body video{max-width:100%;max-height:100%;border-radius:12px}
#statusViewer .sv-close{position:absolute;top:16px;right:16px;background:rgba(255,255,255,.2);border:none;color:white;width:36px;height:36px;border-radius:50%;font-size:20px;cursor:pointer}
#newStatusModal{display:none;position:fixed;inset:0;z-index:9997;background:rgba(0,0,0,.85);align-items:center;justify-content:center;padding:20px;}
#newStatusModal .box{background:#0f2338;padding:24px;border-radius:16px;width:100%;max-width:400px;color:white}
#newStatusModal .box h3{margin-bottom:16px}
#newStatusModal .box input[type=file]{width:100%;padding:10px;background:rgba(255,255,255,.1);border-radius:8px;color:white;margin-bottom:12px}
#newStatusModal .box .row{display:flex;gap:10px;margin-top:12px}
#newStatusModal .box button{flex:1;padding:12px;border:none;border-radius:8px;font-weight:600;cursor:pointer}
#newStatusModal .box .ok{background:var(--pink-neon);color:#0a1929}
#newStatusModal .box .cancel{background:rgba(255,255,255,.15);color:white}

::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-thumb{background:rgba(255,64,129,.3);border-radius:3px}
</style>
</head>
<body>

<!-- SPLASH -->
<div id="splash">
  <h1>Talksy<span>.</span></h1>
  <p>Connectez. Partagez. Discutez.</p>
  <div class="dot"></div>
</div>

<div class="app">
  <!-- LOGIN -->
  <div id="loginScreen">
    <div class="avatar-upload" id="avatarUpload" title="Choisir une photo" onclick="document.getElementById('loginAvatarFile').click()">
      <span id="avatarUploadText">📷</span>
      <div class="plus-badge">+</div>
    </div>
    <input type="file" id="loginAvatarFile" accept="image/*" style="display:none" onchange="previewAvatar(this)">
    <h1>Talksy<span>.</span></h1>
    <p>Créez votre compte et discutez</p>
    <input class="login-field" id="loginName" type="text" placeholder="Votre nom" autocomplete="off">
    
    <div style="display:flex;width:100%;gap:10px;margin-bottom:14px">
      <select id="countryCode" class="login-field" style="width:110px;padding:14px 5px;background:rgba(255,255,255,.1);color:white;border:1px solid rgba(255,255,255,.2);border-radius:12px;outline:none">
        <option value="+243">🇨🇩 +243</option>
        <option value="+1">🇺🇸 +1</option>
